[Unit]
Description=Notes Service Web Application

After=network.target mariadb.service
Requires=mariadb.service

[Service]
Type=simple
User=app
WorkingDirectory=/opt/mywebapp

ExecStartPre=/usr/bin/mysql -u app_user -pAppSecretPass123 notes_db -e "SOURCE /opt/mywebapp/init.sql"

ExecStart=/usr/bin/node server.js --port=3000 --db-host=127.0.0.1 --db-user=app_user --db-pass=AppSecretPass123 --db-name=notes_db

Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target